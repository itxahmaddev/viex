# Copy to `.env` (never commit it) or set these in your host's dashboard.

# REQUIRED — the password every Host and Viewer must present. 8+ characters.
VIEX_PASSWORD=change-me-to-a-long-password

# Optional
PORT=8787
# JSON array of STUN/TURN servers handed to every client (they can still override locally).
# VIEX_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# Folder with the built web viewer to serve at "/" (the release zip and Docker image already include it).
# VIEX_VIEWER_DIR=./public
# Trust X-Forwarded-For for per-IP rate limiting (automatic on Render; set 1 behind your own proxy).
# VIEX_TRUST_PROXY=1
